generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  sessionVersion Int @default(0)
  preferences Json @default("{}")
  createdAt DateTime @default(now())
  accounts Account[]
  sessions Session[]
  resetTokens PasswordResetToken[]
  teams Team[]
  builds Build[]
  favorites Favorite[]
  conversations ChatConversation[]
  history AnalysisHistory[]
}
model Account {
  id String @id @default(cuid())
  userId String
  provider String
  providerAccountId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}
model Session {
  id String @id @default(cuid())
  userId String
  expires DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expires])
}
model PasswordResetToken {
  id String @id
  userId String
  expires DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expires])
}
model Game {
  id String @id
  name String
  region String
  versions GameVersion[]
  expansions GameExpansion[]
  stages CampaignStage[]
  availability PokemonGameAvailability[]
  moveData MoveGameData[]
  learnsets PokemonLearnset[]
  abilities PokemonAbilityAvailability[]
  items ItemGameAvailability[]
  encounters PokemonEncounter[]
  formats BattleFormat[]
  teams Team[]
  builds Build[]
  tiers TierList[]
  stats PokemonGameStats[]
}
model GameVersion {
  id Int @id
  name String @unique
  gameId String
  game Game @relation(fields: [gameId], references: [id])
}
model GameExpansion {
  id String @id
  gameId String
  name String
  game Game @relation(fields: [gameId], references: [id])
}
model PokemonSpecies {
  id Int @id
  identifier String @unique
  name String
  genus String?
  generation Int
  evolvesFromId Int?
  legendary Boolean @default(false)
  mythical Boolean @default(false)
  forms PokemonForm[]
  evolutions Evolution[] @relation("toSpecies")
  descendants Evolution[] @relation("fromSpecies")
}
model PokemonForm {
  id Int @id
  identifier String @unique
  name String
  speciesId Int
  isDefault Boolean
  kind String
  height Float?
  weight Float?
  sprite String?
  artwork String?
  sourceId String
  species PokemonSpecies @relation(fields: [speciesId], references: [id])
  source RankingSource @relation(fields: [sourceId], references: [id])
  stats PokemonStats?
  gameStats PokemonGameStats[]
  types PokemonType[]
  availability PokemonGameAvailability[]
  learnsets PokemonLearnset[]
  abilities PokemonAbilityAvailability[]
  builds Build[]
  members TeamMember[]
  favorites Favorite[]
  tiers TierEntry[]
  encounters PokemonEncounter[]
  @@index([speciesId])
  @@index([kind])
}
model PokemonStats {
  formId Int @id
  hp Int
  attack Int
  defense Int
  specialAttack Int
  specialDefense Int
  speed Int
  form PokemonForm @relation(fields: [formId], references: [id], onDelete: Cascade)
}
model PokemonGameStats {
  formId Int
  gameId String
  hp Int
  attack Int
  defense Int
  specialAttack Int
  specialDefense Int
  speed Int
  form PokemonForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id])
  @@id([formId, gameId])
}
model Type {
  id Int @id
  name String @unique
  pokemon PokemonType[]
  moves Move[]
}
model PokemonType {
  formId Int
  typeId Int
  slot Int
  form PokemonForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  type Type @relation(fields: [typeId], references: [id])
  @@id([formId, slot])
}
model PokemonGameAvailability {
  formId Int
  gameId String
  content String
  minStage Int?
  acquisition String
  verified Boolean @default(false)
  sourceId String
  checkedAt DateTime
  form PokemonForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id])
  source RankingSource @relation(fields: [sourceId], references: [id])
  @@id([formId, gameId])
  @@index([gameId, minStage])
}
model Move {
  id Int @id
  identifier String @unique
  name String
  typeId Int
  category String
  type Type @relation(fields: [typeId], references: [id])
  games MoveGameData[]
  learnsets PokemonLearnset[]
  builds BuildMove[]
}
model MoveGameData {
  moveId Int
  gameId String
  power Int?
  accuracy Int?
  pp Int?
  cooldown Float?
  priority Int?
  category String?
  typeName String?
  range String?
  area String?
  effect String?
  verified Boolean @default(false)
  sourceId String
  move Move @relation(fields: [moveId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id])
  source RankingSource @relation(fields: [sourceId], references: [id])
  @@id([moveId, gameId])
}
model PokemonLearnset {
  formId Int
  moveId Int
  gameId String
  versionGroup Int
  method String
  level Int
  content String
  minStage Int?
  sourceId String
  form PokemonForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  move Move @relation(fields: [moveId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id])
  source RankingSource @relation(fields: [sourceId], references: [id])
  @@id([formId, moveId, versionGroup, method, level])
  @@index([formId, gameId])
}
model Ability {
  id Int @id
  name String
  availability PokemonAbilityAvailability[]
}
model PokemonAbilityAvailability {
  formId Int
  gameId String
  abilityId Int
  hidden Boolean
  form PokemonForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id])
  ability Ability @relation(fields: [abilityId], references: [id])
  @@id([formId, gameId, abilityId])
}
model Item {
  id Int @id
  identifier String @unique
  name String
  kind String
  availability ItemGameAvailability[]
}
model ItemGameAvailability {
  itemId Int
  gameId String
  minStage Int?
  effect String?
  location String?
  sourceId String
  item Item @relation(fields: [itemId], references: [id])
  game Game @relation(fields: [gameId], references: [id])
  source RankingSource @relation(fields: [sourceId], references: [id])
  @@id([itemId, gameId])
}
model Evolution {
  id Int @id
  fromSpeciesId Int
  toSpeciesId Int
  method String
  conditions Json
  from PokemonSpecies @relation("fromSpecies", fields: [fromSpeciesId], references: [id])
  to PokemonSpecies @relation("toSpecies", fields: [toSpeciesId], references: [id])
}
model Location {
  id String @id
  name String
  encounters PokemonEncounter[]
}
model PokemonEncounter {
  id String @id @default(cuid())
  formId Int
  gameId String
  locationId String
  method String
  sourceId String
  form PokemonForm @relation(fields: [formId], references: [id])
  game Game @relation(fields: [gameId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
  source RankingSource @relation(fields: [sourceId], references: [id])
  @@unique([formId, gameId, locationId])
}
model CampaignStage {
  id String @id
  gameId String
  order Int
  name String
  requirements UnlockRequirement[]
  game Game @relation(fields: [gameId], references: [id])
  @@unique([gameId, order])
}
model UnlockRequirement {
  id String @id
  stageId String
  description String
  sourceUrl String?
  stage CampaignStage @relation(fields: [stageId], references: [id])
}
model BattleFormat {
  id String @id
  gameId String
  name String
  mode String
  teamSize Int
  verified Boolean @default(false)
  game Game @relation(fields: [gameId], references: [id])
  regulations BattleRegulation[]
}
model BattleRegulation {
  id String @id
  formatId String
  name String
  historical Boolean
  rules Json
  sourceUrl String
  format BattleFormat @relation(fields: [formatId], references: [id])
}
model Build {
  id String @id @default(cuid())
  userId String
  formId Int
  gameId String
  name String
  style String
  config Json
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  form PokemonForm @relation(fields: [formId], references: [id])
  game Game @relation(fields: [gameId], references: [id])
  moves BuildMove[]
  @@index([userId, gameId])
}
model BuildMove {
  buildId String
  slot Int
  moveId Int
  build Build @relation(fields: [buildId], references: [id], onDelete: Cascade)
  move Move @relation(fields: [moveId], references: [id])
  @@id([buildId, slot])
}
model Team {
  id String @id @default(cuid())
  userId String
  gameId String
  name String
  mode String @default("story")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id])
  members TeamMember[]
  analyses TeamAnalysis[]
  @@index([userId, updatedAt])
}
model TeamMember {
  id String @id @default(cuid())
  teamId String
  slot Int
  formId Int
  config Json
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  form PokemonForm @relation(fields: [formId], references: [id])
  @@unique([teamId, slot])
}
model TeamAnalysis {
  id String @id @default(cuid())
  teamId String
  engineVersion String
  result Json
  createdAt DateTime @default(now())
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
}
model TierList {
  id String @id
  gameId String
  name String
  format String
  kind String
  stage Int?
  game Game @relation(fields: [gameId], references: [id])
  entries TierEntry[]
}
model TierEntry {
  id String @id @default(cuid())
  tierListId String
  formId Int
  tier String
  score Float?
  tierList TierList @relation(fields: [tierListId], references: [id], onDelete: Cascade)
  form PokemonForm @relation(fields: [formId], references: [id])
  evidence RankingEvidence[]
  @@unique([tierListId, formId])
}
model RankingSource {
  id String @id
  name String
  url String
  license String?
  publishedAt DateTime?
  collectedAt DateTime
  confidence String
  forms PokemonForm[]
  availability PokemonGameAvailability[]
  moves MoveGameData[]
  learnsets PokemonLearnset[]
  items ItemGameAvailability[]
  encounters PokemonEncounter[]
  evidence RankingEvidence[]
}
model RankingEvidence {
  id String @id @default(cuid())
  sourceId String
  tierEntryId String
  classification String
  weight Float
  scope String
  format String
  gameId String
  quantitative Boolean
  source RankingSource @relation(fields: [sourceId], references: [id])
  entry TierEntry @relation(fields: [tierEntryId], references: [id], onDelete: Cascade)
  @@unique([sourceId, tierEntryId])
}
model Favorite {
  userId String
  formId Int
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  form PokemonForm @relation(fields: [formId], references: [id])
  @@id([userId, formId])
}
model ChatConversation {
  id String @id @default(cuid())
  userId String
  title String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]
}
model ChatMessage {
  id String @id @default(cuid())
  conversationId String
  role String
  content String
  context Json?
  createdAt DateTime @default(now())
  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}
model AnalysisHistory {
  id String @id @default(cuid())
  userId String
  formId Int
  gameId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}
model DataImportRun {
  id String @id @default(cuid())
  source String
  commit String
  status String
  counts Json?
  error String?
  startedAt DateTime @default(now())
  finishedAt DateTime?
}
model RateLimit {
  key String @id
  count Int
  expires DateTime
  @@index([expires])
}
